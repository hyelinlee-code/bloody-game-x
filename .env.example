# Analytics. Copy to `.env.local` (gitignored) to enable locally.
#
# Leave these unset and the app simply does not initialise PostHog — which is
# what every test run wants, since tools/assert-visual.mjs asserts zero console
# errors and zero failed requests. See src/analytics.ts.
#
# The project API key is public by design: it ships inside the client bundle and
# can only write events. It is NOT the personal API key, which is a secret and
# must never be put in a VITE_ variable — anything VITE_-prefixed is compiled
# into JavaScript that every visitor downloads.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# US cloud (default if unset). EU projects: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
