{
  "name": "bloody-game-x-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsx tools/validate-data.mjs && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173",
    "shots": "node tools/shots.mjs",
    "typecheck": "tsc -b --noEmit",
    "validate": "tsx tools/validate-data.mjs",
    "assert": "node tools/assert-visual.mjs",
    "check": "tsc -b --noEmit && tsx tools/validate-data.mjs && vite build && node tools/assert-visual.mjs --no-build",
    "portraits": "node tools/portraits.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "motion": "^12.43.0",
    "posthog-js": "^1.414.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
